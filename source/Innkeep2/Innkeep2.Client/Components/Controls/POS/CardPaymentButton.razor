@using Innkeep2.Services.Client

<MudPaper Class="pointer noselect" Elevation="0">
    <MudButton
        Variant="Variant.Outlined"
        Color="Color.Info"
        Class="h-100 w-100"
        Disabled="@(!CardPaymentService.CanPayByCard)"
        OnClick="@OpenDialogAsync">
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Outlined.CreditCard" Size="Size.Large"/>
            <MudText Typo="Typo.h4">
                KARTE
            </MudText>
        </MudStack>
    </MudButton>
</MudPaper>
