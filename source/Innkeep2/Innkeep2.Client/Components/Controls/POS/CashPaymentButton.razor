@using Innkeep2.Services.Client
<MudPaper Class="pointer noselect" Elevation="0">
    <MudButton
        Variant="Variant.Outlined"
        Color="Color.Success"
        Class="h-100 w-100"
        @onclick="StartPayment"
        Disabled="@(!CartService.Items.Any())">
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Outlined.Euro" Size="Size.Large"/>
            <MudText Typo="Typo.h4">
                BAR
            </MudText>
        </MudStack>
    </MudButton>
</MudPaper>

@code {

    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    public ClientCartService CartService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += async (_, _) => await InvokeAsync(StateHasChanged);
    }

    private void StartPayment()
    {
        NavigationManager.NavigateTo("/Pay");   
    }

}