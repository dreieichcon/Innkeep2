@using Innkeep2.Models.Internal
@using Innkeep2.Services.Client

<MudStack Row="true" Justify="Justify.SpaceBetween" Spacing="0" Class="sales-button-active" @onclick="AddToCart">
    <MudStack Class="description" Spacing="1" Justify="Justify.Center">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body1" Color="Color.Primary">
                @SalesItem.Name
            </MudText>
            @if (SalesItem.PrintCheckInVoucher)
            {
                <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary" Size="Size.Small"/>
            }
        </MudStack>
        @if (SalesItem.ItemsInStock != null)
        {
            <MudStack Spacing="1">
                <MudText Typo="Typo.body2">Verfügbar: @AmountDisplay()</MudText>
                <MudProgressLinear Min="0" Max="1" Value="@ItemPercentageLeft()" Color="BarColor()"/>
            </MudStack>
        }
    </MudStack>
    <MudStack Class="price" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="0">
        <MudText Typo="Typo.body1" Class="nobreak">
            @SalesItem.Price.ToString("C")
        </MudText>
        @if (SalesItem.TaxRate > 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Error">
                @SalesItem.TaxRate.ToString("##")%
            </MudText>
            <MudText Typo="Typo.subtitle2">
                @PriceWithoutTax.ToString("C")
            </MudText>
        }
    </MudStack>
</MudStack>


@code {

    [CascadingParameter]
    public required SalesItem SalesItem { get; set; }

    [Inject]
    public ClientCartAdditionService CartAdditionService { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    private decimal PriceWithoutTax => SalesItem.Price * (1 - SalesItem.TaxRate / 100);

    private async Task AddToCart()
    {
        var result = await CartAdditionService.AddAsync(SalesItem);

        if (!result.Added)
            Snackbar.Add(result.Message!, Severity.Error);
    }

    private double ItemPercentageLeft()
    {
        if (SalesItem.ItemsInStock is not { } stock || SalesItem.MaxStock is not { } maxStock)
            return 2;

        return ((double)stock / maxStock);
    }

    private Color BarColor()
    {
        return ItemPercentageLeft() switch
        {
            > 1 => Color.Surface,
            > 0.5 => Color.Success,
            > 0.3 => Color.Warning,
            < 0.15 => Color.Error,
            _ => Color.Default,
        };
    }

    private string AmountDisplay()
    {
        if (SalesItem.ItemsInStock is not { } stock || SalesItem.MaxStock is not { } maxStock)
            return "∞";

        return $"{stock} / {maxStock}";
    }

}