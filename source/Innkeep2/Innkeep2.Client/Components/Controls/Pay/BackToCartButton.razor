<MudPaper Class="pointer noselect" Elevation="0">
    <MudButton 
        Variant="Variant.Outlined" 
        Color="Color.Error" 
        Class="h-100 w-100" 
        @onclick="GoBack"
        Disabled="false">
        <MudText Typo="Typo.h4">
            ZURÜCK
        </MudText>
    </MudButton>
</MudPaper>

@code {
    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;
    
    private async Task GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

}