@using Innkeep2.Client.Services
@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Models.Shared
@using Innkeep2.Services.Client
@using Innkeep2.Services.Shared

<MudPaper Class="pointer noselect" Elevation="0">
    <MudButton 
        Variant="Variant.Outlined" 
        Color="Color.Success" 
        Class="h-100 w-100" 
        @onclick="StartTransaction"
        Disabled="TransactionDisabled">
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Large"/>
            <MudText Typo="Typo.h4">
                BESTELLUNG ABSCHICKEN
            </MudText>
        </MudStack>
    </MudButton>
</MudPaper>

@code {
    [Inject]
    public ClientTransactionService TransactionService { get; set; } = null!;

    [Inject]
    public ClientCartService ClientCartService { get; set; } = null!;

    [Inject]
    public PaymentCompletionService PaymentCompletion { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    public LoadingService LoadingService { get; set; } = null!;

    private bool TransactionDisabled => ClientCartService.Items.Count == 0 || !TransactionService.EnoughGiven;

    protected override void OnInitialized()
    {
        TransactionService.Changed += async(_, _) => await InvokeAsync(StateHasChanged);
        ClientCartService.Changed += async(_, _) => await InvokeAsync(StateHasChanged);
    }

    private async Task StartTransaction()
    {
        if (TransactionDisabled)
            return;

        LoadingService.IsLoading = true;

        TransactionReceipt receipt;

        try
        {
            var transactionReceipt = await TransactionService.SubmitOrderAsync();

            if (!transactionReceipt.IsSuccess)
            {
                var error = transactionReceipt.Error!;
                var message = error.Code == "Http.Timeout"
                    ? "Keine Antwort vom Server. Bitte Status prüfen, bevor die Bestellung erneut abgeschickt wird."
                    : error.Message;

                Snackbar.Add(message, Severity.Error);
                return;
            }

            TransactionService.SetAmountGiven(0, true);

            if (transactionReceipt.Value is not { } submitted)
                return;

            receipt = submitted;

            PaymentCompletion.PrintVouchersAndOpenDrawer(receipt);
        }
        catch (Exception ex)
        {
            Serilog.Log.Error(ex, "Submitting order failed unexpectedly");
            Snackbar.Add("Bestellung konnte nicht abgeschickt werden.", Severity.Error);
            return;
        }
        finally
        {
            LoadingService.IsLoading = false;
        }

        await PaymentCompletion.ShowCompletionAsync(receipt);
    }

}