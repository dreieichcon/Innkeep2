@using Innkeep2.Services.Client

<MudDialog Style="min-width: 45vw !important">
    <TitleContent>
        <MudText Typo="Typo.h5">Kartenzahlung</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4" AlignItems="AlignItems.Center" Class="p-2">
            <MudText Typo="Typo.h2" Color="Color.Primary">
                @Session.Amount.ToString("C")
            </MudText>
            <MudDivider Light="true" Class="w-100"/>
            @if (IsWorking)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="w-100"/>
            }
            <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined" Class="w-100">
                <MudText Typo="Typo.h6">@Session.StatusText</MudText>
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (Session.CanSwitchToCash)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Style="min-height: 56px;" OnClick="@SwitchToCash">
                <MudText Typo="Typo.h6">Bar bezahlen</MudText>
            </MudButton>
        }
        @if (Session.CanCancel)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Style="min-height: 56px;" OnClick="@CancelPaymentAsync">
                <MudText Typo="Typo.h6">Zahlung abbrechen</MudText>
            </MudButton>
        }
        @if (Session.CanStart)
        {
            <MudButton Variant="Variant.Outlined" Style="min-height: 56px;" OnClick="@Close">
                <MudText Typo="Typo.h6">Schließen</MudText>
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Style="min-height: 56px;" OnClick="@StartPaymentAsync">
                <MudText Typo="Typo.h6">@StartText</MudText>
            </MudButton>
        }
    </DialogActions>
</MudDialog>
