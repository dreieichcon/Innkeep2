@using Innkeep2.Client.Components.Controls
@inherits LayoutComponentBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider MaxWidth="MaxWidth.ExtraLarge" FullWidth="true" BackdropClick="false" BackgroundClass="dialog-backdrop"/>
<MudSnackbarProvider/>

<MudLayout>
    <AppBar/>
    <MudMainContent Class="h-100 w-100 d-flex">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>