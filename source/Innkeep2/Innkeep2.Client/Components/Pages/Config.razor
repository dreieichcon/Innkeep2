@page "/Config"

@using Innkeep2.Print.Printer
@using Innkeep2.Print.Storage

<MudStack Spacing="2" Class="p-1 h-100 w-100" Style="overflow: hidden;">
    <MudToolBar Dense="true" Class="border">
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" Href="/Config/Credentials">
            Zugangsdaten
        </MudButton>
        <MudSpacer/>
        <MudButton Color="Color.Error" Variant="Variant.Outlined" Href="/">
            Zurück
        </MudButton>
    </MudToolBar>
    <MudGrid Spacing="2">
        <MudItem xs="6">
            <MudCard Outlined="true" Class="h-100 d-flex flex-column">
                <MudCardHeader Class="pb-0">
                    <MudText Typo="Typo.h6">Drucker</MudText>
                </MudCardHeader>
                <MudCardContent Class="py-2 flex-grow-1">
                    <MudStack Row="true" Spacing="2">
                        <MudTextField T="string" @bind-Value="_ipAddress" Label="IP-Adresse" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        <MudNumericField T="int" @bind-Value="_port" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudStack>
                </MudCardContent>
                <MudCardActions Class="px-4 pb-3 pt-0 gap-2 mt-auto">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Style="min-height: 56px;" OnClick="Save">
                        Speichern
                    </MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" Style="min-height: 56px;" OnClick="TestPrint">
                        Testdruck
                    </MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" Style="min-height: 56px;" OnClick="OpenDrawer">
                        Kassenlade öffnen
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        <MudItem xs="6">
            <MudCard Outlined="true" Class="h-100 d-flex flex-column">
                <MudCardHeader Class="pb-0">
                    <MudText Typo="Typo.h6">Kundendisplay</MudText>
                </MudCardHeader>
                <MudCardActions Class="px-4 pb-3 pt-0 mt-auto">
                    <MudButton Color="Color.Secondary"
                               Variant="Variant.Outlined"
                               Style="min-height: 56px;"
                               Href="/customer-display"
                               Target="_blank"
                               UserAttributes="_openDisplayAttributes">
                        Kundendisplay öffnen
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>

@code {

    [Inject]
    public PrinterSettingsRepository SettingsRepository { get; set; } = null!;

    [Inject]
    public NetworkPrinterService PrinterService { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    // A plain onclick keeps the browser's user activation so the popup is not blocked; without it the link opens as a new tab.
    private readonly Dictionary<string, object?> _openDisplayAttributes = new()
    {
        ["onclick"] = "window.open(this.href, 'innkeepCustomerDisplay', 'popup,width=1920,height=1080'); return false;"
    };

    private string _ipAddress = "";
    private int _port;

    protected override void OnInitialized()
    {
       var settings = SettingsRepository.GetOrCreate();
       _ipAddress = settings.IpAddress;
       _port = settings.Port;
    }

    private void Save()
    {
       SettingsRepository.Save(new PrinterSettings { IpAddress = _ipAddress, Port = _port });
       Snackbar.Add("Drucker-Einstellungen gespeichert", Severity.Success);
    }

    private void TestPrint()
    {
       try
       {
          PrinterService.PrintTestPage();
          Snackbar.Add("Testdruck gesendet", Severity.Success);
       }
       catch (Exception ex)
       {
          Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
       }
    }

    private void OpenDrawer()
    {
       try
       {
          PrinterService.OpenDrawer();
          Snackbar.Add("Kassenlade geöffnet", Severity.Success);
       }
       catch (Exception ex)
       {
          Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
       }
    }

}