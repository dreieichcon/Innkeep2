@page "/Config/Credentials"

@using Innkeep2.CredentialsDb.Models
@using Innkeep2.Ui.Shared.Components.Config

<MudStack Spacing="2" Class="p-1 h-100 w-100" Style="overflow-y: auto;">
    <MudToolBar Dense="true" Class="border">
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" Href="/Config">
            Einstellungen
        </MudButton>
        <MudSpacer/>
        <MudButton Color="Color.Error" Variant="Variant.Outlined" Href="/">
            Zurück
        </MudButton>
    </MudToolBar>
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard Outlined="true" Class="h-100">
                <MudCardContent>
                    <ActiveCredentialInfo T="InnkeepApiKey"/>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12">
            <MudCard Outlined="true" Class="h-100">
                <MudCardContent>
                    <InnkeepApiKeyManager Title="Server API Key"/>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12">
            <MudCard Outlined="true" Class="h-100">
                <MudCardContent>
                    <DiscordCredentialManager/>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>
