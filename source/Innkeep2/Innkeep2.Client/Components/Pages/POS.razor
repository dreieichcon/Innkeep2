@page "/"
@using Innkeep2.Client.Components.Controls.POS
@using Innkeep2.Services.Client

<MudStack Row="true" Class="item-thirds p-1 h-100 w-100">
    <MudStack Class="h-100">
        <MudStack Class="pos-top">
            <CartDisplay/>
        </MudStack>
        <MudStack Class="pos-bottom">
            <TotalPriceDisplay/>
        </MudStack>
    </MudStack>
    <SalesItemDisplay/>
    <MudStack Class="action-column h-100">
        <ReloadButton/>
        <ClearButton/>
        <CashPaymentButton/>
        <CardPaymentButton/>
        <ReprintButton/>
    </MudStack>
</MudStack>

@code{

    [Inject]
    private ClientCartService CartService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        CartService.NextItemCount = 1;
        CartService.Changed += async(_, _) => await InvokeAsync(StateHasChanged);
    }

}
