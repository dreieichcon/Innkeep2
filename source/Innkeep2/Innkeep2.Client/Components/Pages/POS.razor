@page "/"
@using Innkeep2.Client.Components.Controls.POS
@using Innkeep2.Client.Components.Controls.Shared
@using Innkeep2.Services.Client

<MudStack Class="p-1 h-100 w-100">
    <MudStack Row="true" Class="item-thirds pos-top">
        <CartDisplay/>
        <SalesItemDisplay/>
        <Keypad DefaultValue="1" @bind-Count="Count"/>
    </MudStack>
    <MudStack Row="true" Class="item-thirds pos-bottom">
        <TotalPriceDisplay/>
        <PayButton/>
        <ReprintButton/>
    </MudStack>
</MudStack>

@code{

    [Inject]
    private ClientCartService CartService { get; set; } = null!;

    public decimal Count
    {
        get => CartService.NextItemCount;
        set => CartService.NextItemCount = (int)value;
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.Changed += async(_, _) => await InvokeAsync(StateHasChanged);
    }

}