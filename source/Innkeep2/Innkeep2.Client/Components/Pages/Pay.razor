@page "/Pay"
@using Innkeep2.Client.Components.Controls.Pay
@using Innkeep2.Client.Components.Controls.POS

<MudStack Row="true" Class="item-thirds p-1 h-100 w-100">
    <MudStack Class="h-100">
        <MudStack Class="pos-top">
            <CartDisplay/>
        </MudStack>
        <MudStack Class="pos-bottom">
            <PaymentPriceDisplay/>
        </MudStack>
    </MudStack>
    <PaymentAmounts/>
    <MudStack Class="action-column h-100">
        <ClearAmountButton/>
        <KeypadDialogButton/>
        <BackToCartButton/>
        <CommitPaymentButton/>
    </MudStack>
</MudStack>
