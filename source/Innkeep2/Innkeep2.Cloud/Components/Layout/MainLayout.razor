@using Innkeep2.Ui.Shared.Layout
@inherits LayoutComponentBase

<ManagementLayout @bind-IsDrawerOpen="_drawerOpen" Roles="innkeep2-admin">
    <AppBarContent>
        <AppBar @bind-DrawerOpen="_drawerOpen"/>
    </AppBarContent>
    <StatusBarContent>
        <StatusBar/>
    </StatusBarContent>
    <DrawerContent>
        <AdminNavMenu Sections="NavigationSections.All"/>
    </DrawerContent>
    <MainContent>
        @Body
    </MainContent>
</ManagementLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{

    private bool _drawerOpen = true;

}
