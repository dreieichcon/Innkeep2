@using System.Text
@using Innkeep2.Cloud.Services
@using Innkeep2.Models.Fiskaly.Tss
@using Innkeep2.Services.Cloud
@using Innkeep2.Services.Cloud.Fiskaly
@using Microsoft.AspNetCore.Components.Authorization

<MudAppBar Elevation="1" Dense="true" Class="innkeep-status-bar">
    <AuthorizeView Roles="innkeep2-admin">
        <MudStack Row="true" Class="w-100" Justify="Justify.SpaceEvenly">
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary" Typo="Typo.body2">
                    Veranstalter:
                </MudText>
                <MudText Typo="Typo.body2">
                    @(ActiveConfiguration.Organizer?.Name ?? "n.A.")
                </MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Light="true"/>
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary" Typo="Typo.body2">
                    Veranstaltung:
                </MudText>
                <MudText Typo="Typo.body2">
                    @(ActiveConfiguration.Event?.Name ?? "n.A.")
                </MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Light="true"/>
            <MudStack Row="true" Spacing="2">
                <MudStack Row="true" Spacing="1">
                    <MudText Color="Color.Primary" Typo="Typo.body2">
                        TSS:
                    </MudText>
                    <MudText Typo="Typo.body2">
                        @if (ActiveConfiguration.Tss != null)
                        {
                            @($"{ActiveConfiguration.Tss.DisplayName} {AuthStatus()}")
                        }
                        else
                        {
                            @("n.A.")
                        }
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    <MudText Color="Color.Primary" Typo="Typo.body2">
                        PIN:
                    </MudText>
                    <MudIcon Icon="@PinStatus()" Size="Size.Small"/>
                </MudStack>
                <MudStack Row="true" Spacing="1" Typo="Typo.body2">
                    <MudText Color="Color.Primary" Typo="Typo.body2">
                        PUK:
                    </MudText>
                    <MudIcon Icon="@PukStatus()" Size="Size.Small"/>
                </MudStack>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Light="true"/>
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary" Typo="Typo.body2">
                    Client:
                </MudText>
                <MudText Typo="Typo.body2">
                    @if (ActiveConfiguration.Client != null)
                    {
                        @($"{ActiveConfiguration.Client.DisplayName}")
                    }
                    else
                    {
                        @("n.A.")
                    }
                </MudText>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Light="true"/>
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary" Typo="Typo.body2">
                    Db:
                </MudText>
                <MudText Typo="Typo.body2">
                    @if (ActiveConfiguration.OrderDatabasePath != null)
                    {
                        @($"{ActiveConfiguration.OrderDatabasePath}")
                    }
                    else
                    {
                        @("n.A.")
                    }
                </MudText>
            </MudStack>
        </MudStack>
    </AuthorizeView>
</MudAppBar>

@code {

    [Inject]
    public IActiveConfigurationService ActiveConfiguration { get; set; } = null!;

    [Inject]
    public TssService TssService { get; set; } = null!;

    private FiskalyTss? ActiveTss => ActiveConfiguration.Tss;

    private string? PukStatus()
    {
        if (ActiveTss is null)
            return null;

        if (TssService.HasPuk(ActiveTss.Id))
            return Icons.Material.Outlined.LockOpen;

        return Icons.Material.Outlined.Lock;
    }
    
    private string? PinStatus()
    {
        if (ActiveTss is null)
            return null;

        if (TssService.HasPin(ActiveTss.Id))
            return Icons.Material.Outlined.LockOpen;

        return Icons.Material.Outlined.Lock;
    }

    private string AuthStatus()
    {
        var sb = new StringBuilder();

        if (ActiveTss is null)
            return sb.ToString();

        if (TssService.HasPuk(ActiveTss.Id))
            sb.Append(" Puk");

        if (TssService.HasPin(ActiveTss.Id))
            sb.Append(" Pin");

        return sb.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        await ActiveConfiguration.RefreshAsync();
        ActiveConfiguration.Changed += RefreshDisplay;
    }

    private void RefreshDisplay(object? sender, EventArgs eventArgs)
    {
        InvokeAsync(StateHasChanged);
    }

}