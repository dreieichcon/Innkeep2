@using System.Text
@using Innkeep2.Cloud.Services
@using Innkeep2.Models.Fiskaly.Tss
@using Innkeep2.Services.Cloud
@using Innkeep2.Services.Cloud.Fiskaly
@using Microsoft.AspNetCore.Components.Authorization

<MudAppBar Elevation="1" Dense="true" Class="innkeep-status-bar">
    <AuthorizeView Roles="innkeep2-admin">
        <MudStack Row="true" Class="w-100">
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary">
                    Veranstalter:
                </MudText>
                <MudText>
                    @(ActiveConfiguration.Organizer?.Name ?? "n.A.")
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary">
                    Veranstaltung:
                </MudText>
                <MudText>
                    @(ActiveConfiguration.Event?.Name ?? "n.A.")
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="1">
                <MudText Color="Color.Primary">
                    TSS:
                </MudText>
                <MudText>
                    @if (ActiveConfiguration.Tss != null)
                    {
                        @($"{ActiveConfiguration.Tss.DisplayName} {AuthStatus()}")
                    }
                    else
                    {
                        @("n.A.")
                    }
                </MudText>
            </MudStack>
        </MudStack>
    </AuthorizeView>
</MudAppBar>

@code {

    [Inject]
    public IActiveConfigurationService ActiveConfiguration { get; set; } = null!;
    
    [Inject]
    public TssService TssService { get; set; } = null!;

    private FiskalyTss? ActiveTss => ActiveConfiguration.Tss;

    private string AuthStatus()
    {
        var sb = new StringBuilder();
        
        if (ActiveTss is null)
            return sb.ToString();

        if (TssService.HasPuk(ActiveTss.Id))
            sb.Append(" Puk");

        if (TssService.HasPin(ActiveTss.Id))
            sb.Append(" Pin");

        return sb.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        await ActiveConfiguration.RefreshAsync();
        ActiveConfiguration.Changed += RefreshDisplay;
    }

    private void RefreshDisplay(object? sender, EventArgs eventArgs)
    {
        InvokeAsync(StateHasChanged);
    }

}