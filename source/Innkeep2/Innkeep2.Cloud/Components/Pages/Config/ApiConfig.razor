@page "/Config/Api"

@using Innkeep2.Cloud.AppDb.Models
@using Innkeep2.Cloud.AppDb.Repositories
@using Innkeep2.Cloud.Components.Pages.Core
@using Innkeep2.Cloud.Services
@using Innkeep2.Ui.Shared.Components.Config
@inherits Innkeep2.Cloud.Components.Pages.Abstract.AbstractUiPage

<ConfigPage Title="API Keys Verwalten">
    <ApiKeyManager 
        T="InnkeepCloudApiKey" 
        Keys="ApiKeys" 
        GenerateKeyFunc="GenerateKey"
        RevokeKeyFunc="RevokeKey"
        UpdateApiKeys="async() => await OnInitializedAsync()"/>
</ConfigPage>

@code {

    [Inject]
    public InnkeepCloudApiKeyRepository ApiKeyRepository { get; set; } = null!;

    [Inject]
    public ApiKeyValidationService ApiKeyValidationService { get; set; } = null!;

    private InnkeepCloudApiKey[] ApiKeys { get; set; } = [];
    
    protected override async Task OnInitializedAsync()
    {
        ApiKeys = (await ApiKeyRepository.GetAllAsync()).Value?.ToArray() ?? [];
    }

    private async Task<string?> GenerateKey(string keyName) 
        => await Handler.TryExecuteAsync(() => ApiKeyValidationService.GenerateApiKey(keyName), errorPrefix: "Fehler beim Erstellen eines Keys");

    private async Task RevokeKey(InnkeepCloudApiKey key)
    {
        await Handler.TryExecuteAsync(
            () => ApiKeyRepository.UpdateAsync(key), 
            errorPrefix: "Fehler beim Deaktivieren", 
            successMessage: "Key erfolgreich deaktiviert");
    }

}