@page "/Config/Api"

@using Innkeep2.Cloud.AppDb.Models
@using Innkeep2.Cloud.AppDb.Repositories
@using Innkeep2.Cloud.Components.Pages.Core
@using Innkeep2.Cloud.Services
@inherits Innkeep2.Cloud.Components.Pages.Abstract.AbstractUiPage

<ConfigPage Title="API Keys Verwalten">
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudStack>
                <MudDataGrid T="InnkeepCloudApiKey" Items="ApiKeys">
                    <NoRecordsContent>
                        <MudText>Keine API Keys vorhanden</MudText>
                    </NoRecordsContent>
                    <Columns>
                        <PropertyColumn Property="x => x.Name"/>
                        <PropertyColumn Property="x => x.CreatedAd"/>
                        <TemplateColumn Title="Aktionen">
                            <CellTemplate>
                                <MudButton OnClick="() => DeactivateKey(context.Item)">Deaktivieren</MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudStack>
                <MudTextField @bind-Value="_keyName" Required="true" Variant="Variant.Outlined" Label="Key Name"/>
                <MudButton OnClick="GenerateKey">Neuen Key Generieren</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</ConfigPage>

@code {

    [Inject]
    public InnkeepCloudApiKeyRepository ApiKeyRepository { get; set; } = null!;
    
    [Inject]
    public ApiKeyValidationService ApiKeyValidationService { get; set; } = null!;

    private InnkeepCloudApiKey[] ApiKeys { get; set; } = [];

    private string? _keyName;

    protected override async Task OnInitializedAsync()
    {
        ApiKeys = (await ApiKeyRepository.GetAllAsync()).Value?.ToArray() ?? [];
    }

    private async Task GenerateKey()
    {
        if (string.IsNullOrWhiteSpace(_keyName))
            return;
        
        var key = await Handler.TryExecuteAsync(() =>  ApiKeyValidationService.GenerateApiKey(_keyName), errorPrefix: "Fehler beim Erstellen eines Keys");

        if (key == null)
            return;
        
        await DialogService.ShowMessageBoxAsync("API Key Angelegt",
            $"Stellen Sie sicher, dass der folgende Key gespeichert ist. Er wird nur einmal angezeigt: {Environment.NewLine}{key}",
            options: new DialogOptions()
            {
                CloseOnEscapeKey = false,
                BackdropClick = false,
                CloseButton = false
            });

        await OnInitializedAsync();
    }

    private async Task DeactivateKey(InnkeepCloudApiKey key)
    {
        var result = await DialogService.ShowMessageBoxAsync("API Key Deaktivieren", "Dieser Schritt kann nicht Rückgängig gemacht werden. Wirklich fortfahren?", yesText: "Ja", noText: "Nein");
        
    }

}