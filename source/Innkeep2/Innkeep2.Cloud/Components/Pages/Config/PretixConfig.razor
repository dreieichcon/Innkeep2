@page "/Config/Pretix"
@using Innkeep2.Cloud.Components.Pages.Abstract
@using Innkeep2.Cloud.Components.Pages.Core
@using Innkeep2.Models.Internal

@inherits Innkeep2.Cloud.Components.Pages.Abstract.AbstractUiPage

<ConfigPage Title="Pretix Einstellungen">
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudStack>
                <MudText>
                    Pretix-Veranstalter
                </MudText>
                <MudSelect @bind-Value="SelectedOrganizer" T="Organizer" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var organizer in Organizers)
                    {
                        <MudSelectItem Value="@organizer">@organizer.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider/>
                <MudText>
                    Pretix-Veranstaltung
                </MudText>
                <MudSelect @bind-Value="SelectedEvent" T="Event" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined">
                    @foreach (var e in Events)
                    {
                        <MudSelectItem Value="@e">@e.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider/>
                <MudCheckBox T="bool" @bind-Value="UseTestMode">
                    Testmodus verwenden
                </MudCheckBox>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudText>@SalesItems.Length Sales Items geladen</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Disabled="@(!_hasChanges)" Color="Color.Primary" OnClick="@SaveSettings">
                    Speichern
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</ConfigPage>

            
