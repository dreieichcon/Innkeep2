@page "/Config/Tss/Create"
@using Innkeep2.Cloud.Components.Pages.Core
@using Innkeep2.Services.Cloud.Fiskaly

@inherits Innkeep2.Cloud.Components.Pages.Abstract.AbstractUiPage

<ConfigPage Title="Neue TSS Anlegen">
    <MudItem xs="12">
        <MudPaper Class="p-2">
            <MudStack>
                <MudText>
                    Mit Klick auf den Button wird eine neue TSS Angelegt.
                    Dies verursacht noch KEINE Kosten.
                </MudText>
                <MudButton OnClick="CreateAsync">TSS Anlegen</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
</ConfigPage>

@code {

    [Inject]
    public TssService TssService { get; set; } = null!;
    
    private async Task CreateAsync()
    {
        var confirmation = await DialogService.ShowMessageBoxAsync("Neue Tss anlegen", "Sind Sie sich sicher?");

        if (confirmation is not true)
            return;

        var tss = await Handler.TryExecuteAsync(() => TssService.CreateAsync(Guid.NewGuid()), "");

        if (tss is null)
            return;

        await DialogService.ShowMessageBoxAsync("Tss Angelegt",
            $"Stellen Sie sicher, dass der folgende PUK gespeichert ist. Er wird nur hier angezeigt: {Environment.NewLine}{tss.AdminPuk}",
            options: new DialogOptions()
            {
                CloseOnEscapeKey = false,
                BackdropClick = false,
                CloseButton = false
            });
    }

}