@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Roles="innkeep2-admin">
    <Authorized>
        <MudText Typo="Typo.h4">Welcome to Innkeep2 Cloud!</MudText>
        <MudText Typo="Typo.body1">You are logged in as an administrator.</MudText>
    </Authorized>
    <NotAuthorized>
        <MudText Typo="Typo.h4">Welcome to Innkeep2 Cloud!</MudText>
        <MudText Typo="Typo.body1">Please <MudLink Target="/Account/Login">log in</MudLink> with an admin account to continue.</MudText>
    </NotAuthorized>
</AuthorizeView>
