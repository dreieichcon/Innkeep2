@inject CachedPretixOrganizerProvider Provider

@page "/"
@using Innkeep2.Models.Internal
@using Innkeep2.Services.Cloud

@inherits Innkeep2.Cloud.Components.Core.AdminPageBase

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@foreach(var organizer in _organizers)
{
    <p>@organizer.Name</p>
}

Welcome to your new app.

@code
{
    IReadOnlyList<Organizer> _organizers = Array.Empty<Organizer>();
    
    protected override async Task OnInitializedAsync()
    {
        var org = await Provider.GetCachedItemsAsync();
        
        if (org.IsSuccess)
        {
            _organizers = org.Value!;
        }
    }
}