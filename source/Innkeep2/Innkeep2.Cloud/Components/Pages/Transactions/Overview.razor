@page "/Transactions/Overview"
@using Innkeep2.Cloud.TransactionDb
@using Innkeep2.Cloud.TransactionDb.Models
@using Innkeep2.Cloud.TransactionDb.Repositories
@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Ui.Shared.Components.Core
@using Innkeep2.Ui.Shared.Components.Receipt
@using Microsoft.EntityFrameworkCore

<ConfigPage Title="Bestellungen: Übersicht" GridClass="w-100">
    <PaperItem Xs="9" FullHeight="true">
        <MudDataGrid T="Transaction" ServerData="ServerData" RowsPerPage="50" Dense="false"
                     FixedHeader="true" Height="100%" Class="h-100 d-flex flex-column"
                     RowClick="e => SelectedTransaction = e.Item">
            <PagerContent>
                <MudDataGridPager/>
            </PagerContent>
            <Columns>
                <PropertyColumn Property="x => x.RequestId"/>
                <PropertyColumn Property="x => x.BookingTime"/>
                <PropertyColumn Property="x => x.TransactionType"/>
                <PropertyColumn Property="x => x.TotalAmount"/>
                <PropertyColumn Property="x => x.PretixStatus"/>
                <PropertyColumn Property="x => x.FiskalyStatus"/>
                <TemplateColumn Title="Original">
                    <CellTemplate>
                        @if (context.Item.RefundRequestId is { } originalId)
                        {
                            <MudLink Href="@($"/Transactions/{originalId}")">@originalId</MudLink>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </PaperItem>
    <PaperItem Xs="3">
        @if (Receipt is not null)
        {
            <ReceiptWebDisplay Receipt="Receipt"/>
        }
    </PaperItem>
</ConfigPage>

@code {

    [Inject]
    public IDbContextFactory<InnkeepTransactionDbContext> OrderContextFactory { get; set; } = null!;

    private Transaction? SelectedTransaction { get; set; }

    private TransactionReceipt? Receipt => SelectedTransaction is not null
       ? TransactionReceiptFactory.FromTransaction(SelectedTransaction)
       : null;

    private async Task<GridData<Transaction>> ServerData(GridState<Transaction> state, CancellationToken ct = default)
    {
       await using var context = await OrderContextFactory.CreateDbContextAsync(ct);

       var query = context.Transactions.OrderByDescending(x => x.BookingTime);

       var total = await query.CountAsync(ct);
       var items = await query.Skip(state.Page * state.PageSize).Take(state.PageSize).ToListAsync(ct);
       
       return new GridData<Transaction>
       {
          Items = items,
          TotalItems = total
       };
    }

}