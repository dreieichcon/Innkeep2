@page "/Transactions/Overview"
@using Innkeep2.Cloud.Components.Core
@using Innkeep2.Cloud.Components.Pages.Core
@using Innkeep2.Cloud.TransactionDb
@using Innkeep2.Cloud.TransactionDb.Models
@using Innkeep2.Cloud.TransactionDb.Repositories
@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Ui.Shared.Components.Receipt
@using Microsoft.EntityFrameworkCore

<ConfigPage Title="Bestellungen: Übersicht">
    <PaperItem Xs="9">
        <MudDataGrid T="Transaction" Virtualize="true" VirtualizeServerData="ServerData" RowsPerPage="50" Dense="false" RowClick="e => SelectedTransaction = e.Item">
            <PagerContent>
                <MudDataGridPager></MudDataGridPager>
            </PagerContent>
            <Columns>
                <PropertyColumn Property="x => x.Id"/>
                <PropertyColumn Property="x => x.TotalAmount"/>
                <PropertyColumn Property="x => x.AmountGiven"/>
                <PropertyColumn Property="x => x.AmountBack"/>
                <PropertyColumn Property="x => x.PaymentType"/>
            </Columns>
        </MudDataGrid>
    </PaperItem>
    <PaperItem Xs="3">
        @if (Receipt != null)
        {
            <ReceiptWebDisplay Receipt="Receipt"/>
        }
    </PaperItem>
</ConfigPage>

@code {

    [Inject]
    public IDbContextFactory<InnkeepTransactionDbContext> OrderContextFactory { get; set; } = null;
    
    private Transaction? SelectedTransaction { get; set; }
    
    private TransactionReceipt? Receipt => SelectedTransaction != null ? TransactionReceiptFactory.FromTransaction(SelectedTransaction) : null;
    
    private async Task<GridData<Transaction>> ServerData(GridStateVirtualize<Transaction> state, CancellationToken ct = default)
    {
        await using var context = await OrderContextFactory.CreateDbContextAsync(ct);

        var orders = context.Transactions.OrderBy(x => x.BookingTime);

        return new GridData<Transaction>()
        {
            Items = await orders.Skip(state.StartIndex).Take(state.Count).ToListAsync(ct),
            TotalItems = orders.Count()
        };
    }
    
}