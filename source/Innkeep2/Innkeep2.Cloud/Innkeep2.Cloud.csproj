<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Innkeep2.Cloud.AppDb\Innkeep2.Cloud.AppDb.csproj" />
      <ProjectReference Include="..\Innkeep2.Cloud.TransactionDb\Innkeep2.Cloud.TransactionDb.csproj" />
      <ProjectReference Include="..\Innkeep2.Database\Innkeep2.Database.csproj" />
      <ProjectReference Include="..\Innkeep2.Services\Innkeep2.Services.csproj" />
      <ProjectReference Include="..\Innkeep2.Credentials\Innkeep2.Credentials.csproj" />
      <ProjectReference Include="..\Innkeep2.Requests\Innkeep2.Requests.csproj" />
      <ProjectReference Include="..\Innkeep2.Ui.Shared\Innkeep2.Ui.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
      <PackageReference Include="MudBlazor" Version="9.10.0" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
      <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
