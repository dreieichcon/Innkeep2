@page "/Transactions/{RequestId:guid}"
@using Innkeep2.Requests.Cloud
@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Models.Shared
@using Innkeep2.Print.Formatter
@using Innkeep2.Print.Printer
@using Innkeep2.Server.Queue
@using Innkeep2.Server.Services
@using Innkeep2.Ui.Shared.Components.Core
@using Innkeep2.Ui.Shared.Components.Receipt
@using MudBlazor

<ListPage Title="Bestellung: Details">
    @if (Receipt is not null)
    {
        <PaperItem Xs="3">
            <ReceiptWebDisplay Receipt="Receipt"/>
        </PaperItem>
        <PaperItem Xs="9">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">Übersicht</MudText>
                <MudText>Typ: @Receipt.TransactionType</MudText>
                <MudText>Datum: @Receipt.BookingTime.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudText>
                <MudText>Gesamt: @Receipt.Sum.TotalAmount.ToString("N2") €</MudText>
                <MudText>Zahlart: @Receipt.PaymentType</MudText>
                @if (Receipt.PretixOrderCode is { } orderCode)
                {
                    <MudText>Pretix: @orderCode</MudText>
                }
                @if (Receipt.RefundRequestId is { } originalId)
                {
                    <MudText>
                        Original:
                        <MudLink Href="@($"/Transactions/{originalId}")">@originalId</MudLink>
                    </MudText>
                }
                <MudDivider Class="my-2"/>

                <MudStack Row="true" Spacing="2">
                    <MudButton Color="Color.Error"
                               Disabled="@(Receipt.TransactionType != TransactionType.Sale || Receipt.IsRefunded)"
                               OnClick="@CancelOrderAsync">
                        Storno
                    </MudButton>
                    <MudButton Color="Color.Primary" OnClick="@ReprintAsync">
                        Erneut Drucken
                    </MudButton>
                    <MudButton OnClick="@(() => Navigation.NavigateTo("/Transactions/Overview", true))">
                        Zurück
                    </MudButton>
                </MudStack>
            </MudStack>
        </PaperItem>
    }
    else if (Queued is not null)
    {
        <PaperItem Xs="12">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">In Warteschlange</MudText>
                <MudText>Typ: @Queued.Type</MudText>
                <MudText>Eingereiht: @Queued.EnqueuedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</MudText>
                <MudText>Versuche: @Queued.Attempts</MudText>
                @if (Queued.LastError is not null)
                {
                    <MudText>Letzter Fehler: @Queued.LastError</MudText>
                }
                <MudButton Href="/Queue" Variant="Variant.Outlined">Zur Warteschlange</MudButton>
            </MudStack>
        </PaperItem>
    }
    else
    {
        <PaperItem Xs="12">
            <MudText>Bestellung nicht gefunden.</MudText>
        </PaperItem>
    }
</ListPage>

@code {

    [Parameter]
    public Guid RequestId { get; set; }

    [Inject]
    public CloudTransactionClient TransactionClient { get; set; } = null!;

    [Inject]
    public ServerTransactionService TransactionService { get; set; } = null!;

    [Inject]
    public NetworkPrinterService PrinterService { get; set; } = null!;

    [Inject]
    public NavigationManager Navigation { get; set; } = null!;

    [Inject]
    public ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    public IDialogService DialogService { get; set; } = null!;

    private TransactionReceipt? Receipt { get; set; }

    private QueuedRequest? Queued { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Receipt = null;
        Queued = null;

        var result = await TransactionClient.GetTransactionAsync(RequestId);

        if (result.IsSuccess)
        {
            Receipt = result.Value;
            return;
        }

        Queued = TransactionService.FindQueued(RequestId);
    }

    private async Task CancelOrderAsync()
    {
        if (Receipt is not { } original)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Bestellung stornieren",
            "Dieser Schritt kann nicht rückgängig gemacht werden. Wirklich fortfahren?",
            yesText: "Ja",
            noText: "Nein"
        );

        if (confirmed is not true)
            return;

        var outcome = await TransactionService.RefundAsync(original);

        if (outcome.Receipt is null)
        {
            Snackbar.Add(outcome.Error ?? "Unbekannter Fehler", Severity.Warning);
            return;
        }

        if (outcome.WasQueued)
            Snackbar.Add("Cloud nicht erreichbar, Storno vorgemerkt", Severity.Warning);
        else
            Snackbar.Add("Bestellung storniert", Severity.Success);

        try
        {
            var bytes = ReceiptDocumentBuilder.Build(outcome.Receipt);
            await Task.Run(() => PrinterService.Print(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Druckfehler: {ex.Message}", Severity.Error);
        }

        Navigation.NavigateTo($"/Transactions/{outcome.Receipt.OrderId}");
    }

    private async Task ReprintAsync()
    {
        if (Receipt is null)
            return;

        try
        {
            var bytes = ReceiptDocumentBuilder.Build(Receipt with { IsCopy = true });
            await Task.Run(() => PrinterService.Print(bytes));
            Snackbar.Add("An Drucker gesendet", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
    }

}