@using Innkeep2.CredentialsDb
@using MudBlazor
@typeparam T where T : class, Innkeep2.CredentialsDb.Models.ICredentialDocument
@implements IDisposable

@if (Provider.Active is { } active)
{
    <MudAlert Severity="Severity.Success">
        Aktive Zugangsdaten: @active.Name
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info">
        Es sind keine aktiven Zugangsdaten hinterlegt. Bitte Zugangsdaten anlegen und aktivieren.
    </MudAlert>
}

@code {

    [Inject]
    public ActiveCredentialProvider<T> Provider { get; set; } = null!;

    protected override void OnInitialized() => Provider.Changed += OnProviderChanged;

    public void Dispose() => Provider.Changed -= OnProviderChanged;

    private void OnProviderChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

}
