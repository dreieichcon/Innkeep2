@using MudBlazor
@typeparam T where T : class, Innkeep2.CredentialsDb.Models.ICredentialDocument

<MudDataGrid T="T" Items="Items">
    <NoRecordsContent>
        <MudText>Keine Zugangsdaten vorhanden</MudText>
    </NoRecordsContent>
    <Columns>
        <PropertyColumn Property="x => x.Name" Title="Name"/>
        <TemplateColumn Title="Aktiv">
            <CellTemplate>
                @if (context.Item.Active)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                }
            </CellTemplate>
        </TemplateColumn>
        @ExtraColumns
        <TemplateColumn Title="Aktionen">
            <CellTemplate>
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="() => OnEdit.InvokeAsync(context.Item)"/>
                    <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew"
                                   Size="Size.Small"
                                   Disabled="@context.Item.Active"
                                   OnClick="() => OnActivate.InvokeAsync(context.Item)"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="() => OnDelete.InvokeAsync(context.Item)"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {

    [Parameter]
    public IReadOnlyList<T> Items { get; set; } = [];

    [Parameter]
    public RenderFragment? ExtraColumns { get; set; }

    [Parameter]
    public EventCallback<T> OnEdit { get; set; }

    [Parameter]
    public EventCallback<T> OnActivate { get; set; }

    [Parameter]
    public EventCallback<T> OnDelete { get; set; }

}
