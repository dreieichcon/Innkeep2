@using MudBlazor
@typeparam T where T : class, Innkeep2.CredentialsDb.Models.ICredentialDocument

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">@Title</MudText>
        @if (AllowCreate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           Disabled="@(_editing is not null)"
                           OnClick="StartCreate"/>
        }
    </MudStack>

    @if (_showRestartHint)
    {
        <MudAlert Severity="Severity.Warning">
            Neustart der Anwendung erforderlich, damit die Zugangsdaten wirksam werden.
        </MudAlert>
    }

    <CredentialGrid T="T"
                    Items="_items"
                    ExtraColumns="ExtraColumns"
                    OnEdit="StartEdit"
                    OnActivate="ActivateAsync"
                    OnDelete="DeleteAsync"/>

    @if (_editing is { } credential)
    {
        <CredentialEditForm Title="@(_isNew ? "Neue Zugangsdaten" : "Zugangsdaten bearbeiten")"
                            @bind-Name="credential.Name"
                            OnSave="SaveAsync"
                            OnCancel="Cancel">
            @Fields?.Invoke(credential)
        </CredentialEditForm>
    }
</MudStack>
