@using Innkeep2.CredentialsDb.Models
@using MudBlazor

<CredentialManager T="CredentialPair" Title="Pretix / Fiskaly Zugangsdaten" CreateNew="CreateNew" Clone="Clone">
    <ExtraColumns>
        <PropertyColumn T="CredentialPair" TProperty="string" Property="x => x.Pretix.BaseUrl" Title="Pretix URL"/>
    </ExtraColumns>
    <Fields Context="credential">
        <MudText Typo="Typo.subtitle1">Pretix</MudText>
        <MudTextField T="string"
                      Label="Basis-URL"
                      Variant="Variant.Outlined"
                      Required="true"
                      Validation="@UrlValidator.Validation"
                      Value="@credential.Pretix.BaseUrl"
                      ValueChanged="@(value => SetPretixUrl(credential, value))"/>
        <SecretField Label="API Key"
                     Required="true"
                     Value="@credential.Pretix.ApiKey"
                     ValueChanged="@(value => SetPretixKey(credential, value))"/>
        <MudText Typo="Typo.subtitle1">Fiskaly</MudText>
        <SecretField Label="API Key"
                     Required="true"
                     Value="@credential.Fiskaly.ApiKey"
                     ValueChanged="@(value => SetFiskalyKey(credential, value))"/>
        <SecretField Label="API Secret"
                     Required="true"
                     Value="@credential.Fiskaly.ApiSecret"
                     ValueChanged="@(value => SetFiskalySecret(credential, value))"/>
    </Fields>
</CredentialManager>
