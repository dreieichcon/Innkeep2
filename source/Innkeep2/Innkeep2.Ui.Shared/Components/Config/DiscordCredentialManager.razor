@using Innkeep2.CredentialsDb.Models

<CredentialManager T="DiscordCredential" Title="Discord Logging" CreateNew="CreateNew" Clone="Clone">
    <Fields Context="credential">
        <SecretField Label="Webhook URL"
                     Required="true"
                     Validation="@UrlValidator.Validation"
                     @bind-Value="credential.WebhookUrl"/>
    </Fields>
</CredentialManager>
