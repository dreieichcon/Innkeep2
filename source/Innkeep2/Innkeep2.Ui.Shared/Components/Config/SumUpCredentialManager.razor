@using Innkeep2.CredentialsDb.Models
@using MudBlazor

<CredentialManager T="SumUpCredential" Title="SumUp Kartenzahlung" CreateNew="CreateNew" Clone="Clone">
    <ExtraColumns>
        <PropertyColumn T="SumUpCredential" TProperty="string" Property="x => x.MerchantCode" Title="Händlercode"/>
    </ExtraColumns>
    <Fields Context="credential">
        <SecretField Label="API Key" Required="true" @bind-Value="credential.ApiKey"/>
        <MudTextField T="string"
                      Label="Händlercode"
                      Variant="Variant.Outlined"
                      Required="true"
                      @bind-Value="credential.MerchantCode"/>
        <MudTextField T="string"
                      Label="Öffentliche Basis-URL (HTTPS)"
                      Variant="Variant.Outlined"
                      Required="true"
                      Validation="@UrlValidator.Validation"
                      @bind-Value="credential.PublicBaseUrl"/>
        <MudTextField T="string"
                      Label="Webhook-URL"
                      Variant="Variant.Outlined"
                      ReadOnly="true"
                      Value="@WebhookUrl(credential)"/>
        <MudText Typo="Typo.subtitle1">Affiliate Key (optional)</MudText>
        <MudTextField T="string"
                      Label="App-ID"
                      Variant="Variant.Outlined"
                      @bind-Value="credential.AffiliateAppId"/>
        <SecretField Label="Key" @bind-Value="credential.AffiliateKey"/>
        <SumUpConnectionTest Credential="credential"/>
    </Fields>
</CredentialManager>
