@using Innkeep2.CredentialsDb.Models
@using MudBlazor

<CredentialManager T="SumUpReaderCredential" Title="SumUp Reader" AllowCreate="false" CreateNew="CreateNew" Clone="Clone">
    <ExtraColumns>
        <PropertyColumn T="SumUpReaderCredential" TProperty="string" Property="x => x.DeviceModel" Title="Modell"/>
        <PropertyColumn T="SumUpReaderCredential" TProperty="string" Property="x => x.ReaderId" Title="Reader-ID"/>
    </ExtraColumns>
    <Fields Context="credential">
        <MudTextField T="string" Label="Reader-ID" Variant="Variant.Outlined" ReadOnly="true" Value="@credential.ReaderId"/>
        <MudTextField T="string" Label="Händlercode" Variant="Variant.Outlined" ReadOnly="true" Value="@credential.MerchantCode"/>
        <MudTextField T="string" Label="Modell" Variant="Variant.Outlined" ReadOnly="true" Value="@credential.DeviceModel"/>
    </Fields>
</CredentialManager>
