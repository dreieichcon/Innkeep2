@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<AuthorizeView Roles="innkeep2-admin">
    <MudStack Class="w-100 config-page" AlignItems="AlignItems.Center">
        <MudPaper Class="@($"p-2 {GridClass}")">
            <MudText Typo="Typo.h4">
                @Title
            </MudText>
            <MudText Typo="Typo.h6">
                @SubTitle
            </MudText>
        </MudPaper>
        <MudGrid Class="@($"{GridClass} fill-remaining")" Justify="Justify.Center">
            @ChildContent
        </MudGrid>
    </MudStack>
</AuthorizeView>

@code {

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? SubTitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public int MainContentSize { get; set; } = 12;

    [Parameter]
    public string GridClass { get; set; } = "w-75";

}