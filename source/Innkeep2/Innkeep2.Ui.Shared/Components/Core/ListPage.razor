@using MudBlazor

<MudStack Class="w-100" Justify="Justify.Center" AlignItems="AlignItems.Center">
    <MudGrid Class="@GridClass" Justify="Justify.Center">
        <MudItem xs="@MainContentSize">
            <MudPaper Class="p-2">
                <MudText Typo="Typo.h4">
                    @Title
                </MudText>
                <MudText Typo="Typo.h6">
                    @SubTitle
                </MudText>
            </MudPaper>
        </MudItem>
        @ChildContent
    </MudGrid>
</MudStack>

@code {

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? SubTitle { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public int MainContentSize { get; set; } = 12;

    [Parameter]
    public string GridClass { get; set; } = "w-75";

}