@using MudBlazor

<MudStack Class="@PageClass">
    <MudPaper Class="p-2">
        <MudText Typo="Typo.h4">
            @Title
        </MudText>
        <MudText Typo="Typo.h6">
            @SubTitle
        </MudText>
    </MudPaper>
    <MudGrid Class="management-page-grid" Justify="Justify.Center">
        @ChildContent
    </MudGrid>
</MudStack>

@code {

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? SubTitle { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string PageClass => FullWidth ? "management-page management-page--full" : "management-page";

}
