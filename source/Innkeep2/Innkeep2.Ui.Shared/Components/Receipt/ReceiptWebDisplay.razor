@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Print
@using MudBlazor
@using QRCoder
@preservewhitespace true

<style>

   .whitespace {
      white-space: pre;
      font-family: monospace;
   }

   .double {
      font-size: 200%;
   }

   .plusfifty {
      font-size: 150%;
   }

   .center {
      text-align: center;
   }

   .receipt {
      font-family: monospace;
      width: 45ch;
      padding: 1ch;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
   }
   
   .receipt-wrapper{
      font-size: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
   }


</style>

<MudPaper Class="receipt-wrapper" Elevation="0">
   <div class="receipt border">
      <div class="whitespace double center">@Receipt.Title</div>
      @foreach (var line in Receipt.Header.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries))
      {
         <div class="whitespace center">@line</div>
      }
      <MudDivider Class="my-2" DividerType="DividerType.FullWidth" Light="true"/>
      <div class="whitespace plusfifty">@ReceiptFormatter.FormatReceiptTypeLabel(Receipt)</div>
      @foreach (var line in ReceiptFormatter.FormatSubheading(Receipt))
      {
         <div class="whitespace center">@line</div>
      }
      <MudDivider Class="my-2" DividerType="DividerType.FullWidth" Light="true"/>
      @foreach (var line in Receipt.Lines)
      {
         @foreach (var printLine in ReceiptFormatter.FormatLines(line))
         {
            <div class="whitespace">@printLine</div>
         }
      }
      <MudDivider Class="my-2" DividerType="DividerType.FullWidth" Light="true"/>

      @foreach (var line in ReceiptFormatter.FormatSum(Receipt))
      {
         <div class="whitespace center">@line</div>
      }

      <MudDivider Class="my-2" DividerType="DividerType.FullWidth" Light="true"/>

      @foreach (var tax in ReceiptFormatter.FormatTaxInformation(Receipt.TaxInformation))
      {
         <div class="whitespace">@tax</div>
      }

      <MudDivider Class="my-2" DividerType="DividerType.FullWidth" Light="true"/>

      @if (Receipt.HasFiskalyQrCode)
      {
         <div class="d-flex justify-center my-2">
            @((MarkupString)BuildQrSvg(Receipt.FiskalyQrCode!))
         </div>
      }
      
   </div>
</MudPaper>

@code {

   [Parameter, EditorRequired]
   public TransactionReceipt Receipt { get; set; }

   private static string BuildQrSvg(string content)
   {
      using var generator = new QRCodeGenerator();
      using var data = generator.CreateQrCode(content, QRCodeGenerator.ECCLevel.M);
      return new SvgQRCode(data).GetGraphic(5);
   }

}