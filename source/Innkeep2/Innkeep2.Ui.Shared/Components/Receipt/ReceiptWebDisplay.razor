@using Innkeep2.Models.Internal.Receipt
@using Innkeep2.Models.Shared
@using Innkeep2.Ui.Shared.Components.Receipt.Segments
@using MudBlazor
@preservewhitespace true

<style>

   .whitespace {
      white-space: pre;
      font-family: monospace;
   }

   .double {
      font-size: 200%;
   }

   .plusfifty {
      font-size: 150%;
   }

   .center {
      text-align: center;
   }

   .receipt {
      font-family: monospace;
      width: 45ch;
      padding: 1ch;
      display: flex;
      flex-direction: column;
      justify-content: center;
      box-sizing: border-box;
   }

   .receipt-wrapper {
      font-size: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
       overflow-y: scroll;
       overflow-x: hidden;
       max-height: 80vh !important;
   }

</style>

<MudPaper Class="receipt-wrapper" Elevation="0">
    <div class="receipt border">
        <ReceiptHeader Receipt="Receipt"/>

        @switch (Receipt.TransactionType)
        {
            case TransactionType.Sale:
                <ReceiptProducts Receipt="Receipt"/>
                <ReceiptSum Receipt="Receipt"/>
                <ReceiptTax Receipt="Receipt"/>
                <ReceiptQr Receipt="Receipt"/>
                <ReceiptVouchers Receipt="Receipt"/>
                break;

            case TransactionType.Refund:
                <ReceiptSum Receipt="Receipt"/>
                <ReceiptQr Receipt="Receipt"/>
                break;

            case TransactionType.Transfer:
                <ReceiptSum Receipt="Receipt"/>
                <ReceiptQr Receipt="Receipt"/>
                <ReceiptSignature/>
                break;
        }
    </div>
</MudPaper>

@code {

    [Parameter, EditorRequired]
    public required TransactionReceipt Receipt { get; set; }

}