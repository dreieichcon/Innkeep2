@using Innkeep2.Models.Internal.Receipt
@using MudBlazor
@using QRCoder

@foreach (var voucher in Receipt.Vouchers)
{
    <div class="whitespace double center">@Receipt.Title</div>
    <br/>
    <div class="whitespace center">@voucher.ItemName</div>
    <br/>
    <div class="whitespace center">Id: @Receipt.OrderId</div>
    <br/>
    @if (!string.IsNullOrEmpty(voucher.Secret))
    {
        <div class="d-flex justify-center my-2">
            @((MarkupString)BuildQrSvg(voucher.Secret))
        </div>
    }
    <MudDivider Class="my-4" DividerType="DividerType.FullWidth" Style="border-style: dashed;"/>
}

@code {
    [Parameter, EditorRequired]
    public required TransactionReceipt Receipt { get; set; }

    private static string BuildQrSvg(string content)
    {
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(content, QRCodeGenerator.ECCLevel.M);
        return new SvgQRCode(data).GetGraphic(5);
    }
}