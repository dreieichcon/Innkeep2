@using Innkeep2.Models.Internal
@using MudBlazor

<MudItem Xs="4">
    <MudPaper Class="p-2">
        <MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@SalesItem.Name</MudText>
                @if (SalesItem.PrintCheckInVoucher)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary"/>
                }
            </MudStack>
            <MudStack Spacing="1">
                <MudText>Preis: @SalesItem.Price.ToString("C")</MudText>
                <MudText>Steuer: @SalesItem.TaxRate %</MudText>
                <MudText>Preis ohne Steuer: @PriceWithoutTax.ToString("C") </MudText>
            </MudStack>
            <MudStack Spacing="1">
                <MudText>Verfügbar: @AmountDisplay()</MudText>
                <MudProgressLinear Min="0" Max="1" Value="@ItemPercentageLeft()" Color="BarColor()"/>
            </MudStack>
        </MudStack>
    </MudPaper>
</MudItem>

@code {

    [Parameter]
    public SalesItem SalesItem { get; set; } = null!;

    private decimal PriceWithoutTax => SalesItem.Price * (1 - SalesItem.TaxRate / 100);

    private double ItemPercentageLeft()
    {
        if (SalesItem.ItemsInStock is not { } stock || SalesItem.MaxStock is not { } maxStock)
            return 2;

        return ((double)stock / maxStock);
    }

    private Color BarColor()
    {
        return ItemPercentageLeft() switch
        {
            > 1 => Color.Surface,
            > 0.5 => Color.Success,
            > 0.3 => Color.Warning,
            < 0.15 => Color.Error,
            _ => Color.Default,
        };
    }

    private string AmountDisplay()
    {
        if (SalesItem.ItemsInStock is not { } stock || SalesItem.MaxStock is not { } maxStock)
            return "∞";

        return $"{stock} / {maxStock}";
    }

}