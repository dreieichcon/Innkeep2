@using Innkeep2.Services.Shared
@using Innkeep2.Ui.Shared.Theme
@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@InnkeepTheme.Theme" IsDarkMode="@DarkModeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider MaxWidth="MaxWidth.ExtraLarge" FullWidth="true" BackdropClick="false" BackgroundClass="dialog-backdrop"/>
<MudSnackbarProvider />

<MudLayout>
    @TopContent
    <MudMainContent Class="h-100 w-100 d-flex">
        @MainContent
    </MudMainContent>
</MudLayout>

@code{
    
    [Parameter]
    public RenderFragment? MainContent { get; set; }
    
    [Parameter]
    public RenderFragment? TopContent { get; set; }
    
    [Inject]
    public DarkModeService DarkModeService { get; set; } = null!;

    protected override void OnInitialized()
    {
        DarkModeService.Changed += OnDarkModeChanged;
    }

    private void OnDarkModeChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);
}