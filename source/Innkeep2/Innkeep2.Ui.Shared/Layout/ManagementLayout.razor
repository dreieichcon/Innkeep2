@using Innkeep2.Ui.Shared.Theme
@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@InnkeepTheme.Theme" IsDarkMode="@IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="management-layout">
    @TopContent
    <MudDrawer Open="@IsDrawerOpen" ClipMode="DrawerClipMode.Always">
        @DrawerContent
    </MudDrawer>
    <MudMainContent>
        <div class="main-content">
            <MudStack Class="p-3">
                @MainContent
            </MudStack>
        </div>
    </MudMainContent>
</MudLayout>

@code{
    
    private bool IsDarkMode = true;
    
    [Parameter]
    public RenderFragment? MainContent { get; set; }
    
    [Parameter]
    public RenderFragment? TopContent { get; set; }
    
    [Parameter]
    public RenderFragment? DrawerContent { get; set; }
    
    [Parameter]
    public bool IsDrawerOpen { get; set; }
    
    [Parameter]
    public EventCallback<bool> IsDrawerOpenChanged { get; set; }

}