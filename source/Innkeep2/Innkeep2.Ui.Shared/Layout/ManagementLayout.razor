@using Innkeep2.Services.Shared
@using Innkeep2.Ui.Shared.Components.Core
@using Innkeep2.Ui.Shared.Theme
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@InnkeepTheme.Theme" IsDarkMode="@DarkModeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (string.IsNullOrEmpty(Roles))
{
    @RenderShell(true, true)
}
else
{
    <AuthorizeView Roles="@Roles">
        <Authorized>
            @RenderShell(true, true)
        </Authorized>
        <NotAuthorized>
            @RenderShell(false, context.User.Identity?.IsAuthenticated ?? false)
        </NotAuthorized>
    </AuthorizeView>
}

@code{

    [Parameter]
    public RenderFragment? MainContent { get; set; }

    [Parameter]
    public RenderFragment? AppBarContent { get; set; }

    [Parameter]
    public RenderFragment? StatusBarContent { get; set; }

    [Parameter]
    public RenderFragment? DrawerContent { get; set; }

    [Parameter]
    public bool IsDrawerOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsDrawerOpenChanged { get; set; }

    /// <summary>
    /// Roles required to see the layout content. Without roles, everything is shown.
    /// </summary>
    [Parameter]
    public string? Roles { get; set; }

    [Inject]
    public DarkModeService DarkModeService { get; set; } = null!;

    protected override void OnInitialized()
    {
        DarkModeService.Changed += OnDarkModeChanged;
    }

    private void OnDarkModeChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    private string LayoutClass(bool isAllowed)
        => isAllowed ? "management-layout" : "management-layout management-layout--locked";

    private RenderFragment RenderShell(bool isAllowed, bool isAuthenticated) => @<MudLayout Class="@LayoutClass(isAllowed)">
        @AppBarContent
        @if (isAllowed)
        {
            @StatusBarContent
            <MudDrawer Open="@IsDrawerOpen" OpenChanged="@IsDrawerOpenChanged" Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always">
                @DrawerContent
            </MudDrawer>
        }
        <MudMainContent>
            <MudStack Class="p-3">
                @if (isAllowed)
                {
                    @MainContent
                }
                else
                {
                    <AccessRequired IsAuthenticated="@isAuthenticated"/>
                }
            </MudStack>
        </MudMainContent>
    </MudLayout>;

}
