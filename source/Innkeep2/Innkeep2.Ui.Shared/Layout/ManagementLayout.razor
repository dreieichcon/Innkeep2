@using Innkeep2.Services.Shared
@using Innkeep2.Ui.Shared.Theme
@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@InnkeepTheme.Theme" IsDarkMode="@DarkModeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="management-layout">
    @TopContent
    <MudDrawer Open="@IsDrawerOpen" ClipMode="DrawerClipMode.Always">
        @DrawerContent
    </MudDrawer>
    <MudMainContent>
        <div class="main-content">
            <MudStack Class="p-3">
                @MainContent
            </MudStack>
        </div>
    </MudMainContent>
</MudLayout>

@code{
    
    [Parameter]
    public RenderFragment? MainContent { get; set; }
    
    [Parameter]
    public RenderFragment? TopContent { get; set; }
    
    [Parameter]
    public RenderFragment? DrawerContent { get; set; }
    
    [Parameter]
    public bool IsDrawerOpen { get; set; }
    
    [Parameter]
    public EventCallback<bool> IsDrawerOpenChanged { get; set; }
    
    [Inject]
    public DarkModeService DarkModeService { get; set; } = null!;

    protected override void OnInitialized()
    {
        DarkModeService.Changed += OnDarkModeChanged;
    }

    private void OnDarkModeChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

}