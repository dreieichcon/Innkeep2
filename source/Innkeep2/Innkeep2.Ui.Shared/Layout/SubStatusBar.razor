@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@if (Authorize)
{
    <MudAppBar Elevation="1" Dense="true" Class="innkeep-status-bar">
        <AuthorizeView Roles="innkeep2-admin">
            <MudStack Row="true" Class="w-100" Justify="Justify.SpaceEvenly">
                @ChildContent
            </MudStack>
        </AuthorizeView>
    </MudAppBar>
}
else
{
    <MudAppBar Elevation="1" Dense="true" Class="innkeep-status-bar">
        <MudStack Row="true" Class="w-100" Justify="Justify.SpaceEvenly">
            @ChildContent
        </MudStack>
    </MudAppBar>
}


@code {
    
    [Parameter]
    public bool Authorize { get; set; }
    
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}